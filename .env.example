# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Base URL used when building shareable gallery links.
# On Vercel this must be the live https://… URL, not localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ random characters, e.g. `openssl rand -hex 32`
GALLERY_SESSION_SECRET=your_random_secret_32_chars
